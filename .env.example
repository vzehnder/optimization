# Copy this file to .env and replace the password.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=energy_dispatch
DB_USER=energy_dispatch_user
DB_PASSWORD=change-me
ARTIFACT_ROOT=.tmp/artifacts
INPUT_SOURCE_ROOT=.tmp/input-sources
JULIA=julia
